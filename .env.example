NEXT_PUBLIC_SITE_URL=https://connectirl.xyz
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Required exclusively for the account deletion endpoint.
SUPABASE_SERVICE_ROLE_KEY=
# Optional MapLibre style URL. Defaults to OpenFreeMap with attribution.
NEXT_PUBLIC_MAP_STYLE=https://tiles.openfreemap.org/styles/positron
NEXT_PUBLIC_CONTACT_EMAIL=
# Server-only X API app bearer token for public profile-photo lookup.
X_BEARER_TOKEN=
# Resend SMTP is configured in Supabase Auth, not in the browser.
# Sender: Connect IRL <hello@connectirl.xyz>, after verifying the domain in Resend.
# Host: smtp.resend.com | Port: 465 | User: resend | Password: Resend API key.
