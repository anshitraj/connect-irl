{
  "name": "connectirl",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "email:assets": "node scripts/build-email-assets.mjs",
    "email:templates": "vitest run tests/unit/email-templates.test.ts -u",
    "test:e2e": "playwright test",
    "format": "prettier --write src tests *.ts *.mjs public/sw.js",
    "test:production": "playwright test --config playwright.production.config.ts",
    "test:auth": "playwright test --config playwright.auth.config.ts",
    "postinstall": "node scripts/copy-map-worker.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.3.1",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "@zxing/browser": "0.2.1",
    "@zxing/library": "0.23.0",
    "clsx": "2.1.1",
    "lucide-react": "1.61.0",
    "maplibre-gl": "6.15.0",
    "motion": "14.6.0",
    "next": "16.4.3",
    "papaparse": "5.7.0",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@electric-sql/pglite": "0.5.11",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/papaparse": "5.5.2",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  },
  "type": "module"
}
